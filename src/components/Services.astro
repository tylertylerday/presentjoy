---
import Button from './Button.astro';

const services = [
	{
		number: '01',
		title: 'Recover From Addiction',
		body: 'I know that asking for help with drugs and alcohol takes heart and courage. Whether you are trying to slow down for a season or stop altogether, I’m here to support you.',
		href: '/services',
	},
	{
		number: '02',
		title: 'Manage Your Anger',
		body: 'I apply what I’ve learned through years of leading anger management groups to teach you the skills that are needed to deal with what is a very human, yet harmful emotion.',
		href: '/services',
	},
	{
		number: '03',
		title: 'Move On From Depression and Grief & Loss',
		body: 'I approach depression and grief and loss with attention, empathy, attunement and sensitivity.',
		href: '/services',
	},
];
---

<section class="services">
	<h2>Services</h2>

	<p class="services-tagline">Individual Psychotherapy to help you</p>

	<div class="services-grid">
		{
			services.map(({ number, title, body, href }) => (
				<article class="service">
					<p class="service-number">{number}</p>
					<h3>{title}</h3>
					<p class="service-body">{body}</p>

					<div class="service-actions">
						<Button href={href} variant="text">
							Read more
						</Button>
					</div>
				</article>
			))
		}
	</div>
</section>

<style>
	.services {
		/* Tighter above, to close the gap to the Intro section. */
		padding-block: clamp(2rem, 4vw, 3rem) clamp(3rem, 8vw, 6rem);
	}

	/* Centred label with a hairline running out to both edges. */
	.services-tagline {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 3vw, 2rem);
		margin: 1.5rem 0 clamp(2.5rem, 5vw, 4rem);
		color: var(--brand-blue);
		font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
		text-align: center;
	}

	.services-tagline::before,
	.services-tagline::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--hairline);
	}

	.services-grid {
		display: grid;
		gap: clamp(2.5rem, 5vw, 3.5rem);
	}

	@media (min-width: 48rem) {
		.services-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.service {
		display: flex;
		flex-direction: column;
	}

	.service-number {
		margin: 0 0 1rem;
		color: var(--muted);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.12em;
	}

	.service h3 {
		margin: 0 0 0.875rem;
		font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem);
		font-weight: 600;
		line-height: 1.3;
		text-wrap: balance;
	}

	.service-body {
		margin: 0;
		font-size: 1rem;
		line-height: 1.7;
		text-wrap: pretty;
	}

	/* Pushed to the bottom so all three line up regardless of copy length. */
	.service-actions {
		margin-top: auto;
		padding-top: 1.75rem;
	}
</style>
