---
import { Image } from 'astro:assets';
import portrait from '../assets/david.png';
import Button from './Button.astro';
---

<section class="intro" data-reveal>
	<Image
		class="intro-photo"
		src={portrait}
		alt="David, the Licensed Clinical Social Worker behind Present Joy"
		widths={[304, 480, 608, 760]}
		sizes="(max-width: 48rem) 100vw, 19rem"
	/>

	<div class="intro-copy">
		{/* The home page's h1. The rule below holds its previous size, so the
		    rank is for search engines and screen readers, not the eye. */}
		<h1>Recovery begins here.</h1>
		<p>I will walk with you on your road to recovery.</p>

		<div class="intro-actions">
			<Button href="/about">Read more</Button>
		</div>
	</div>
</section>

<style>
	.intro {
		display: grid;
		align-items: center;
		/* Tighter below, to close the gap to the Services section. */
		padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 4vw, 3rem);
	}

	@media (min-width: 48rem) {
		.intro {
			grid-template-columns: 1fr 2fr;
			align-items: stretch;
		}
	}

	.intro :global(.intro-photo) {
		display: block;
		width: 100%;
		height: auto;
	}

	.intro-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		background: #fff;
		padding: clamp(1.5rem, 4vw, 2.75rem);
	}

	/* Smaller than the full-width section headings — this one sits in a
	   narrower column beside the photo. */
	.intro-copy h1 {
		margin-bottom: 1rem;
		font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
	}

	.intro-actions {
		margin-top: 1.75rem;
	}

	.intro-copy p {
		max-width: 34ch;
		margin: 0;
		font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
		line-height: 1.7;
		text-wrap: pretty;
	}
</style>
