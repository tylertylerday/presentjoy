---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Nav from './Nav.astro';
import heroImage from '../assets/hero.jpg';
---

<section class="hero">
	<Image
		class="hero-bg"
		src={heroImage}
		alt=""
		width={2560}
		height={1707}
		widths={[960, 1440, 1920, 2560]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
	/>

	<div class="hero-inner">
		<Nav />

		<div class="hero-content">
			<div class="container">
				<div class="hero-copy">
					<p data-reveal>
						Present Joy is a walk of hope that does not ask for more than we can give, yet gives
						more than we dared ask. It is a pilgrimage that lasts a lifetime for those who seek
						recovery, not a cure; progress, not perfection. It is a journey that rejoices on the
						other side of the burdens we carry and pains we try to hide. Present Joy is the
						recovery that guides us all our days and the conviction that keeps us every step of
						the way.
					</p>

					<Button href="/about" data-reveal>Learn More</Button>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* Renders outside <main>, so it already spans the full viewport width.
	   Avoids 100vw, which would overflow by the scrollbar width. */
	.hero {
		position: relative;
		min-height: 100svh;
		overflow: hidden;
		isolation: isolate;
	}

	/* Full-bleed photo behind everything in the hero. */
	.hero :global(.hero-bg) {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 55%;
	}

	/* Softens the photo so the blue logo and copy stay legible over the sky. */
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(
			to bottom,
			rgb(255 255 255 / 0.55) 0%,
			rgb(255 255 255 / 0.4) 45%,
			rgb(255 255 255 / 0) 85%
		);
	}

	.hero-inner {
		display: flex;
		min-height: 100svh;
		flex-direction: column;
	}

	.hero-content {
		display: grid;
		flex: 1;
		align-content: center;
		/* Extra bottom padding pulls the copy up, scaled to viewport height so
		   it rises on tall screens without crowding short ones. The horizontal
		   gutter comes from .container. */
		padding-block: 1rem clamp(5rem, 24svh, 20rem);
	}

	/* Centers the copy and button as one block within the page gutter. The
	   button stays on the block's left edge, flush with the start of the text. */
	.hero-copy {
		margin-inline: auto;
	}

	.hero-content p {
		margin: 0 0 2.75rem;
		color: var(--brand-blue);
		font-size: clamp(1rem, 0.95rem + 0.45vw, 1.25rem);
		line-height: 1.75;
		text-wrap: pretty;
	}

	/* Held to 60% of the section width. Full width below the breakpoint, where
	   60% would leave the copy in a very narrow column. */
	@media (min-width: 48rem) {
		.hero-copy {
			max-width: 60%;
		}

		/*
		 * The next section rides up over the hero's bottom edge. That pull is
		 * width-derived while the padding above is height-derived, so on a
		 * short, wide viewport the two disagree and the section lands on top of
		 * the copy. Reserving at least the overlap plus a margin keeps them
		 * apart at every ratio.
		 */
		.hero-content {
			padding-bottom: max(
				clamp(5rem, 24svh, 20rem),
				calc(var(--section-overlap) + 3rem)
			);
		}
	}
</style>
