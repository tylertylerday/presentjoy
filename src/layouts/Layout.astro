---
import { getImage } from 'astro:assets';
import Backdrop from '../components/Backdrop.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { business, phoneHref } from '../data/business';
import { shareImages, type ShareImage } from '../data/share';

interface Props {
	title: string;
	/** Shown under the title in search results and link previews. */
	description: string;
	/** The picture this page shares as. Most pages lead with the practitioner. */
	share?: ShareImage;
}

const { title, description, share: shareChoice = shareImages.david } = Astro.props;

// Pages with a hero render the nav inside it, overlaid on the photo.
const hasHero = Astro.slots.has('hero');

// A section above the footer makes the backdrop tall and growable.
const hasOutro = Astro.slots.has('outro');

// Trailing slashes off, so every page has one address search can index.
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);

// 1200x630 is the size Facebook, LinkedIn and X all crop to.
const toShareCard = (choice: ShareImage) =>
	getImage({ src: choice.image, width: 1200, height: 630, format: 'jpeg' });

const share = await toShareCard(shareChoice);
const shareUrl = new URL(share.src, Astro.site);

/*
 * The practice is one entity across the site, so its schema image stays put
 * even where a page shares as something else.
 */
const practiceImage = await toShareCard(shareImages.david);
const practiceImageUrl = new URL(practiceImage.src, Astro.site);

/*
 * Tells search engines this is a real practice at a real address — the part
 * that earns a map placement for local searches. Kept to facts already on the
 * site so the two can't disagree.
 */
const schema = {
	'@context': 'https://schema.org',
	'@type': 'MedicalBusiness',
	'@id': `${business.url}/#practice`,
	name: business.name,
	description: business.description,
	url: business.url,
	email: business.email,
	telephone: phoneHref.replace('tel:', ''),
	image: practiceImageUrl.href,
	priceRange: business.priceRange,
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.address.street,
		addressLocality: business.address.city,
		addressRegion: business.address.region,
		postalCode: business.address.postalCode,
		addressCountry: 'US',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.geo.latitude,
		longitude: business.geo.longitude,
	},
	areaServed: business.areaServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
	medicalSpecialty: 'Psychiatric',
	availableService: business.services.map((name) => ({ '@type': 'MedicalTherapy', name })),
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={shareUrl.href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={shareChoice.alt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareUrl.href} />
		<meta name="twitter:image:alt" content={shareChoice.alt} />

		<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
		{/* Runs before paint so entrance animations only hide their targets
		    when JS is actually available to reveal them again. */}
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		{!hasHero && <Nav />}
		<slot name="hero" />
		<main>
			<slot />
		</main>

		<Backdrop extended={hasOutro}>
			<slot name="outro" />
			<Footer />
		</Backdrop>

		<script>
			import { revealOnLoad } from '../scripts/reveal';

			revealOnLoad();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--brand-blue: #004cd6;
		--muted: #7c8598;
		--hairline: #d5ddef;

		/* The Intro photo is square and fills a third of the container, so it
		   is a third of the content width tall. That section rides up over the
		   hero by half of it, and the hero reserves the same amount as
		   clearance — hence one definition for both. Keep in step with Intro's
		   grid-template-columns. */
		--intro-photo-size: calc((min(60rem, 100vw) - 3rem) / 3);
		--section-overlap: calc(var(--intro-photo-size) / 2);

		/* Page titles and section headings read at one size, so they stay in
		   step from a single definition. */
		--heading-size: clamp(1.5rem, 1.3rem + 1vw, 2rem);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	/* Hidden only when JS can run the entrance animation; without it everything
	   renders normally. */
	html.js [data-reveal] {
		opacity: 0;
	}

	body {
		margin: 0;
		background: #fff;
		color: #1a1a1a;
		font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
		overflow-x: hidden;
	}

	/* Shared page- and section-heading treatment. */
	h1 {
		margin: 0;
		color: var(--brand-blue);
		font-size: var(--heading-size);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.015em;
		text-wrap: balance;
	}

	h2 {
		margin: 0;
		color: var(--brand-blue);
		font-size: var(--heading-size);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	/* Shared page gutter, for sections that sit outside <main>. */
	.container {
		max-width: 60rem;
		margin-inline: auto;
		padding-inline: 1.5rem;
	}

	main {
		max-width: 60rem;
		margin: 0 auto;
		padding: 0 1.5rem 4rem;
	}

	/* Hero-only pages shouldn't get a trailing white strip. */
	main:empty {
		display: none;
	}
</style>
