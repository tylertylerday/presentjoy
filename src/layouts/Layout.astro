---
import Backdrop from '../components/Backdrop.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;

// Pages with a hero render the nav inside it, overlaid on the photo.
const hasHero = Astro.slots.has('hero');

// A section above the footer makes the backdrop tall and growable.
const hasOutro = Astro.slots.has('outro');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{/* Runs before paint so entrance animations only hide their targets
		    when JS is actually available to reveal them again. */}
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		{!hasHero && <Nav />}
		<slot name="hero" />
		<main>
			<slot />
		</main>

		<Backdrop extended={hasOutro}>
			<slot name="outro" />
			<Footer />
		</Backdrop>

		<script>
			import { revealOnLoad } from '../scripts/reveal';

			revealOnLoad();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--brand-blue: #004cd6;
		--muted: #7c8598;
		--hairline: #d5ddef;

		/* The Intro photo is square and fills a third of the container, so it
		   is a third of the content width tall. That section rides up over the
		   hero by half of it, and the hero reserves the same amount as
		   clearance — hence one definition for both. Keep in step with Intro's
		   grid-template-columns. */
		--intro-photo-size: calc((min(60rem, 100vw) - 3rem) / 3);
		--section-overlap: calc(var(--intro-photo-size) / 2);

		/* Page titles and section headings read at one size, so they stay in
		   step from a single definition. */
		--heading-size: clamp(1.5rem, 1.3rem + 1vw, 2rem);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	/* Hidden only when JS can run the entrance animation; without it everything
	   renders normally. */
	html.js [data-reveal] {
		opacity: 0;
	}

	body {
		margin: 0;
		background: #fff;
		color: #1a1a1a;
		font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
		overflow-x: hidden;
	}

	/* Shared page- and section-heading treatment. */
	h1 {
		margin: 0;
		color: var(--brand-blue);
		font-size: var(--heading-size);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.015em;
		text-wrap: balance;
	}

	h2 {
		margin: 0;
		color: var(--brand-blue);
		font-size: var(--heading-size);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	/* Shared page gutter, for sections that sit outside <main>. */
	.container {
		max-width: 60rem;
		margin-inline: auto;
		padding-inline: 1.5rem;
	}

	main {
		max-width: 60rem;
		margin: 0 auto;
		padding: 0 1.5rem 4rem;
	}

	/* Hero-only pages shouldn't get a trailing white strip. */
	main:empty {
		display: none;
	}
</style>
