---
import { Image } from 'astro:assets';
import portrait from '../assets/david.png';
import Button from './Button.astro';
---

<section class="intro" data-reveal>
	<Image
		class="intro-photo"
		src={portrait}
		alt="David"
		sizes="(max-width: 48rem) 100vw, 19rem"
	/>

	<div class="intro-copy">
		<h2>Recovery begins here.</h2>
		<p>I will walk with you on your road to recovery.</p>

		<div class="intro-actions">
			<Button href="/about">Read more</Button>
		</div>
	</div>
</section>

<style>
	.intro {
		display: grid;
		align-items: center;
		/* Tighter below, to close the gap to the Services section. */
		padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 4vw, 3rem);
	}

	@media (min-width: 48rem) {
		.intro {
			position: relative;
			z-index: 1;
			grid-template-columns: 1fr 2fr;
			align-items: stretch;
			padding-top: 0;
			/* Rides up over the hero by half the photo's height. */
			margin-top: calc(-1 * var(--section-overlap));
		}
	}

	.intro :global(.intro-photo) {
		display: block;
		width: 100%;
		height: auto;
	}

	.intro-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		background: #fff;
		padding: clamp(1.5rem, 4vw, 2.75rem);
	}

	/* Smaller than the full-width section headings — this one sits in a
	   narrower column beside the photo. */
	.intro-copy h2 {
		margin-bottom: 1rem;
		font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
	}

	.intro-actions {
		margin-top: 1.75rem;
	}

	.intro-copy p {
		max-width: 34ch;
		margin: 0;
		font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
		line-height: 1.7;
		text-wrap: pretty;
	}
</style>
